# Copy this file to .env and fill in the values you need.
# The site runs and builds fine with none of these set — they only
# enable specific features (database, lead-notification email).

# --- Database (optional) ---
# MySQL connection string. Without this, lead submissions from the
# homepage inquiry form fall back to opening the visitor's email app
# instead of being saved.
DATABASE_URL=

# --- Lead notification email (optional) ---
# SMTP credentials used to email you when someone submits the project
# inquiry form. Works with Gmail (use an App Password), Zoho, or any
# standard SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address inquiries are sent FROM (often the same as SMTP_USER)
SMTP_FROM=
# Address inquiries are sent TO — defaults to SMTP_USER if unset
LEAD_NOTIFICATION_EMAIL=hello@zorbittechnology.com

# --- Analytics (optional) ---
# Umami analytics script — leave blank to disable analytics entirely.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Server ---
PORT=3000
