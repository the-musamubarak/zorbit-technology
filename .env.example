# Copy this file to .env and fill in the values you need.
# The site builds and runs fine with none of these set the inquiry form
# just falls back to opening the visitor's email app instead of sending
# through Resend.

# --- Email via Resend ---
# Sign up at https://resend.com, verify your domain (zorbittechnology.com.ng)
# under Domains, and create an API key.
RESEND_API_KEY=
# Must be an address on your verified domain, e.g. hello@zorbittechnology.com.ng
EMAIL_FROM=
# Where new-inquiry notifications and forwarded inbound mail are sent.
LEAD_NOTIFICATION_EMAIL=zorbittechnology@gmail.com
# Long random value included in the Resend webhook URL as ?token=...
RESEND_INBOUND_WEBHOOK_TOKEN=

# --- Analytics (optional) ---
# Umami analytics script leave blank to disable.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# When deploying on Vercel, set these as Environment Variables in your
# Vercel project settings (Settings → Environment Variables). .env files
# aren't used in production there.
